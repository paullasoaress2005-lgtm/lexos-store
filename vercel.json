{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/plugins",
      "destination": "/plugins.html"
    },
    {
      "source": "/conteudos",
      "destination": "/conteudos.html"
    },
    {
      "source": "/comunidade",
      "destination": "/comunidade.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
